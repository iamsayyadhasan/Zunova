# ==========================================
# Zunova Tech — Environment Configuration
# ==========================================

# Base Site URL
NEXT_PUBLIC_SITE_URL=https://zunova.tech

# Contact Delivery Provider (Optional)
# To activate automated email delivery to your inbox upon form submission,
# configure an API key from Resend (resend.com) or an SMTP provider.
RESEND_API_KEY=

# Inquiries Destination Email Address
CONTACT_DESTINATION_EMAIL=inquiries@zunova.tech

# WhatsApp Direct Business Channel (Optional)
# Provide the international phone number (e.g., +1234567890 or 1234567890 without spaces or dashes)
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_WHATSAPP_DISPLAY=
